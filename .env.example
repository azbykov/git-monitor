# Auth.js v5 + GitHub OAuth App: github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:3000 (на проде — ваш домен)
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# Для прода нужно отдельное OAuth App со своим callback URL.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Необязательно, для прода: ваш личный токен (classic PAT со scope repo, read:org).
# Когда вы входите через GitHub под тем же логином, что и владелец токена, данные грузятся по нему —
# так видны организации, которые не одобрили OAuth-приложение. Остальные пользователи его не получают.
# На Vercel отметьте переменную как Sensitive.
OWNER_GITHUB_TOKEN=
# Только для `pnpm dev`: работать от этого токена без входа и без OAuth App (например, вывод `gh auth token`).
# В production-сборке игнорируется. Тогда AUTH_* локально можно не заполнять.
DEV_GITHUB_TOKEN=
# Секрет для шифрования сессий: npx auth secret  или  openssl rand -base64 32
AUTH_SECRET=
# Postgres: на Vercel — Neon из Marketplace (подставит сам), локально — postgres://localhost/git_monitor
DATABASE_URL=
# Через сколько рабочих часов (без выходных) PR без ревью подсвечивается. По умолчанию 48
REVIEW_SLA_HOURS=
# AI-анализ замечаний (пока скрыт). true — показать кнопку «Проанализировать»
AI_ANALYSIS_ENABLED=
OPENAI_API_KEY=
OPENAI_MODEL=
